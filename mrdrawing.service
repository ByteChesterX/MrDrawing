[Unit]
Description=MrDrawing Go Server - E2.Micro optimized
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/mrdrawing
ExecStart=/opt/mrdrawing/server
Restart=always
RestartSec=3
MemoryMax=256M
CPUQuota=80%
Environment=GOMAXPROCS=1 GOGC=50

[Install]
WantedBy=multi-user.target
